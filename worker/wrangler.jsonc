{
  // Worker Isoligne : aperçus de liens (jalon 3), puis synchro, push et partage.
  // L'identifiant de compte vient de CLOUDFLARE_ACCOUNT_ID (CI), jamais du dépôt.
  "name": "isoligne-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ORIGINES": "https://matthiasc71.github.io,http://localhost:5173,http://localhost:4173",
    // Instance personnelle : un seul espace (le vôtre). Les tests locaux relèvent ce plafond.
    "ESPACES_MAX": "1"
  },
  "observability": { "enabled": false },
  // Rappels : un passage toutes les 5 minutes (1 des 5 Cron Triggers gratuits).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isoligne",
      // Rempli au déploiement (jalon 4) ; un identifiant de base n'est pas un secret.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
